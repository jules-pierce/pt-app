rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in user can read user docs (needed for provider → client email lookup).
    // Only the owner can write their own doc, and it must carry a non-empty first and last name.
    match /users/{userId} {
      allow read:  if request.auth != null;
      allow create, update: if request.auth.uid == userId && hasName(request.resource.data);
      allow delete:         if request.auth.uid == userId;
    }

    function hasName(data) {
      return data.firstName is string && data.firstName.size() > 0 &&
             data.lastName  is string && data.lastName.size()  > 0;
    }

    match /programs/{programId} {
      // Client or provider of this program can read it.
      allow read: if request.auth != null && (
        resource.data.clientId   == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );
      // Only a provider can create programs (and must set themselves as providerId).
      allow create: if request.auth != null &&
        request.resource.data.providerId == request.auth.uid;
      // Only the provider who owns the program can update or delete it.
      allow update, delete: if request.auth != null &&
        resource.data.providerId == request.auth.uid;

      match /workouts/{workoutId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/programs/$(programId)).data.clientId   == request.auth.uid ||
          get(/databases/$(database)/documents/programs/$(programId)).data.providerId == request.auth.uid
        );
        // Provider can do anything; client can update (to save weights).
        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/programs/$(programId)).data.providerId == request.auth.uid;
        allow update: if request.auth != null &&
          get(/databases/$(database)/documents/programs/$(programId)).data.clientId == request.auth.uid;
      }
    }
  }
}
